{
  "name": "@stackline/color",
  "version": "1.0.3",
  "description": "A tiny, framework-agnostic color picker foundation for modern web applications.",
  "license": "MIT",
  "author": "Alexandro Paixao Marques",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandroit/color.git"
  },
  "bugs": {
    "url": "https://github.com/alexandroit/color/issues"
  },
  "homepage": "https://alexandro.net/docs/vanilla/color/",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "SECURITY.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:docs": "node scripts/build-docs.mjs",
    "build:download": "node scripts/build-download.mjs",
    "build:all": "npm run build && npm run build:docs && npm run build:download",
    "postbuild": "node scripts/normalize-declarations.mjs",
    "clean": "rm -rf dist",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "typecheck:legacy": "node node_modules/typescript-3-9/bin/tsc -p scripts/tsconfig.typescript-3.9.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run typecheck:legacy && npm run build:docs && npm run build:download"
  },
  "keywords": [
    "stackline",
    "npm-package",
    "color",
    "typescript",
    "color-picker",
    "color-conversion",
    "hex",
    "rgb",
    "hsl",
    "hsv",
    "alpha",
    "javascript",
    "browser",
    "dom",
    "accessibility",
    "framework-agnostic"
  ],
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.28.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-3-9": "npm:typescript@3.9.10"
  },
  "overrides": {
    "tsup": {
      "esbuild": "^0.28.2"
    }
  }
}
